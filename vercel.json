{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/slack-notify.js": {
      "maxDuration": 5
    },
    "api/lead.js": {
      "maxDuration": 5
    },
    "api/create-checkout.js": {
      "maxDuration": 10
    },
    "api/stripe-webhook.js": {
      "maxDuration": 10
    },
    "api/charge-meeting.js": {
      "maxDuration": 10
    },
    "api/onboard.js": {
      "maxDuration": 10
    },
    "api/admin-accounts.js": {
      "maxDuration": 10
    }
  }
}
